# Port du serveur Express
PORT=5000

# Environnement (development / production / test)
NODE_ENV=development

# URI de connexion MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/todolist

# URL du client frontend autorisé pour CORS
CLIENT_URL=http://localhost:5173

# Secret JWT pour la signature des tokens d'authentification
JWT_SECRET=super_secret_jwt_key_production_change_me_12345
JWT_EXPIRES_IN=7d
